{
  "manifest_version": 3,
  "name": "Taskelio",
  "version": "0.1.0",
  "description": "Seu trabalho, contado. Crie regras para acompanhar atividades sem contar manualmente.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Taskelio", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_page": "app.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
